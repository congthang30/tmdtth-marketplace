NODE_ENV=development
PORT=3100
API_GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tmdtth?schema=public"
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=55433
POSTGRES_PORT=5432
POSTGRES_DB=tmdtth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_ADMIN_DB=postgres
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=1d
ADMIN_EMAILS=admin@example.com
SELLER_EMAILS=seller@example.com
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
# Backend-only secret. Never expose this value through VITE_* variables.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_FOLDER=tmdtth/products
