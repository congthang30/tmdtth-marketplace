NODE_ENV=development
PORT=3100
API_GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://easybuyss.io.vn
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tmdtth?schema=public"
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=55433
POSTGRES_PORT=5432
POSTGRES_DB=tmdtth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_ADMIN_DB=postgres
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=1d
ADMIN_EMAILS=admin@example.com
SELLER_EMAILS=seller@example.com
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
# Backend-only secret. Never expose this value through VITE_* variables.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_FOLDER=tmdtth/products
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit or rotate this key without a ciphertext re-encryption plan.
# Preferred rotatable keyring: comma-separated keyId:base64Key entries.
SELLER_DATA_ENCRYPTION_KEYS=current:replace-with-base64-encoded-32-byte-key
SELLER_DATA_ACTIVE_KEY_ID=current
# Backward-compatible single-key fallback; omit when using the keyring above.
# SELLER_DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
SELLER_DOCUMENT_CLOUDINARY_FOLDER=tmdtth/seller-documents
SELLER_DOCUMENT_MAX_FILE_SIZE_BYTES=10485760
SELLER_DOCUMENT_SIGNED_URL_TTL_SECONDS=300
# SMTP email verification (Gmail: host smtp.gmail.com, port 587, app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TMDTTH Marketplace <no-reply@example.com>"
# Shared OTP challenge store and HMAC secret. Generate secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REDIS_URL=redis://localhost:6379
OTP_HMAC_SECRET=replace-with-a-random-32-byte-secret
# AI chatbot (backend only). Generate CHAT_HMAC_SECRET with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OPENAI_API_KEY=
# Keep /v1. Override only when using an OpenAI-compatible gateway.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_MAX_TOOL_CALLS=4
CHAT_HMAC_SECRET=replace-with-a-random-32-byte-secret
CHAT_CONVERSATION_TTL_SECONDS=86400
CHAT_CONFIRMATION_TTL_SECONDS=300
CHAT_MAX_MESSAGES=30
CHAT_GUEST_RATE_LIMIT_MAX=10
CHAT_USER_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=300
# GHN (Giao Hang Nhanh) sandbox API. Register at https://5sao.ghn.dev to get
# a test Token + ShopId. Leave blank to run with GHN treated as unconfigured
# (health check reports disconnected, quotes/orders fail with a clear error).
GHN_API_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=

# VNPay Sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://easybuyss.io.vn/payments/vnpay/return
VNPAY_PAYMENT_TTL_MINUTES=15
# Shared carrier HTTP client tuning (optional).
CARRIER_API_TIMEOUT_MS=10000
CARRIER_API_RETRY_COUNT=2

# SePay bank webhook authentication. Disabled by default for local/test.
# Generate secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SEPAY_WEBHOOK_ENABLED=false
SEPAY_WEBHOOK_SECRET=replace-with-a-random-32-byte-secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=