NODE_ENV=development
PORT=3100
API_GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tmdtth?schema=public"
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=55433
POSTGRES_PORT=5432
POSTGRES_DB=tmdtth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_ADMIN_DB=postgres
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=1d
ADMIN_EMAILS=admin@example.com
SELLER_EMAILS=seller@example.com
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
# Backend-only secret. Never expose this value through VITE_* variables.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_FOLDER=tmdtth/products
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit or rotate this key without a ciphertext re-encryption plan.
# Preferred rotatable keyring: comma-separated keyId:base64Key entries.
SELLER_DATA_ENCRYPTION_KEYS=current:replace-with-base64-encoded-32-byte-key
SELLER_DATA_ACTIVE_KEY_ID=current
# Backward-compatible single-key fallback; omit when using the keyring above.
# SELLER_DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
SELLER_DOCUMENT_CLOUDINARY_FOLDER=tmdtth/seller-documents
SELLER_DOCUMENT_MAX_FILE_SIZE_BYTES=10485760
SELLER_DOCUMENT_SIGNED_URL_TTL_SECONDS=300
# GHN (Giao Hang Nhanh) sandbox API. Register at https://5sao.ghn.dev to get
# a test Token + ShopId. Leave blank to run with GHN treated as unconfigured
# (health check reports disconnected, quotes/orders fail with a clear error).
GHN_API_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=

# VNPay Sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payments/vnpay/return
VNPAY_PAYMENT_TTL_MINUTES=15
# Shared carrier HTTP client tuning (optional).
CARRIER_API_TIMEOUT_MS=10000
CARRIER_API_RETRY_COUNT=2

