  updatedAt               DateTime? @map("UpdatedAt") @db.Timestamp(3)

  order         Order         @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  transactions    PaymentTransaction[]
  statusHistories PaymentStatusHistory[]
  refundRequests  RefundRequest[]
  refunds         Refund[]

  @@index([orderId])
  @@index([paymentMethodId])
  @@index([paymentStatus])
  @@map("Payments")
}

model PaymentTransaction {
  id                      BigInt   @id @default(autoincrement()) @map("PaymentTransactionID")
  paymentId               BigInt   @map("PaymentID")
  transactionCode         String   @map("TransactionCode") @db.VarChar(255)
  transactionType         String   @map("TransactionType") @db.VarChar(50)
  transactionStatus       String   @map("TransactionStatus") @db.VarChar(50)
  amount                  Decimal  @map("Amount") @db.Decimal(18, 2)
  providerResponseCode    String?  @map("ProviderResponseCode") @db.VarChar(100)
  providerResponseMessage String?  @map("ProviderResponseMessage") @db.VarChar(1000)
  rawResponse             String?  @map("RawResponse") @db.Text
  createdAt               DateTime @default(now()) @map("CreatedAt") @db.Timestamp(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([paymentId])
  @@map("PaymentTransactions")
}

model PaymentStatusHistory {
  id         BigInt   @id @default(autoincrement()) @map("PaymentStatusHistoryID")
  paymentId  BigInt   @map("PaymentID")
  fromStatus String?  @map("FromStatus") @db.VarChar(50)
  toStatus   String   @map("ToStatus") @db.VarChar(50)
  reason     String?  @map("Reason") @db.VarChar(1000)
  createdAt  DateTime @default(now()) @map("CreatedAt") @db.Timestamp(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([paymentId])
  @@map("PaymentStatusHistories")
}

model Voucher {
  id                BigInt   @id @default(autoincrement()) @map("VoucherID")
  voucherCode       String   @unique @map("VoucherCode") @db.VarChar(50)
  voucherName       String   @map("VoucherName") @db.VarChar(150)
  shopId            BigInt?  @map("ShopID")
  discountType      String   @map("DiscountType") @db.VarChar(50)
  discountValue     Decimal  @map("DiscountValue") @db.Decimal(18, 2)
  maxDiscountAmount Decimal? @map("MaxDiscountAmount") @db.Decimal(18, 2)
  minOrderAmount    Decimal  @default(0) @map("MinOrderAmount") @db.Decimal(18, 2)
  usageLimit        Int?     @map("UsageLimit")
  usedCount         Int      @default(0) @map("UsedCount")
  startAt           DateTime @map("StartAt") @db.Timestamp(3)
  endAt             DateTime @map("EndAt") @db.Timestamp(3)
  voucherStatus     String   @default("Active") @map("VoucherStatus") @db.VarChar(50)
  discountTarget    String   @default("Product") @map("DiscountTarget") @db.VarChar(50)
  productScope      String   @default("AllProducts") @map("ProductScope") @db.VarChar(50)
  createdAt         DateTime @default(now()) @map("CreatedAt") @db.Timestamp(3)

  shop                  Shop?                 @relation(fields: [shopId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usages                VoucherUsage[]
  voucherCategories     VoucherCategory[]
  voucherProducts       VoucherProduct[]
  voucherShopCategories VoucherShopCategory[]

  @@index([shopId])
  @@map("Vouchers")
}

model VoucherCategory {
  voucherId  BigInt   @map("VoucherID")
  categoryId BigInt   @map("CategoryID")
  createdAt  DateTime @default(now()) @map("CreatedAt") @db.Timestamp(3)

  voucher  Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([voucherId, categoryId])
  @@index([categoryId])
  @@map("VoucherCategories")
}

model VoucherProduct {
  voucherId BigInt   @map("VoucherID")
  productId BigInt   @map("ProductID")
  createdAt DateTime @default(now()) @map("CreatedAt") @db.Timestamp(3)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([voucherId, productId])
  @@index([productId])
  @@map("VoucherProducts")
}

model ShopCategory {
  id                   BigInt    @id @default(autoincrement()) @map("ShopCategoryID")
  shopId               BigInt    @map("ShopID")
  parentShopCategoryId BigInt?   @map("ParentShopCategoryID")
  categoryName         String    @map("CategoryName") @db.VarChar(150)
  slug                 String    @map("Slug") @db.VarChar(180)
  description          String?   @map("Description") @db.VarChar(500)
  imageUrl             String?   @map("ImageUrl") @db.VarChar(1000)
  sortOrder            Int       @default(0) @map("SortOrder")
  isActive             Boolean   @default(true) @map("IsActive")
  createdAt            DateTime  @default(now()) @map("CreatedAt") @db.Timestamp(3)
  updatedAt            DateTime? @map("UpdatedAt") @db.Timestamp(3)

  shop              Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent            ShopCategory?         @relation("ShopCategoryTree", fields: [parentShopCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children          ShopCategory[]        @relation("ShopCategoryTree")
  categoryProducts  ShopCategoryProduct[]
  voucherCategories VoucherShopCategory[]

  @@unique([shopId, slug])
  @@index([shopId, isActive, sortOrder])
  @@map("ShopCategories")
}

model ShopCategoryProduct {
  shopCategoryId BigInt   @map("ShopCategoryID")
  productId      BigInt   @map("ProductID")
  sortOrder      Int      @default(0) @map("SortOrder")
  createdAt      DateTime @default(now()) @map("CreatedAt") @db.Timestamp(3)

  shopCategory ShopCategory @relation(fields: [shopCategoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([shopCategoryId, productId])
  @@index([productId])
  @@map("ShopCategoryProducts")
}

model VoucherShopCategory {
  voucherId      BigInt   @map("VoucherID")
  shopCategoryId BigInt   @map("ShopCategoryID")
  createdAt      DateTime @default(now()) @map("CreatedAt") @db.Timestamp(3)

  voucher      Voucher      @relation(fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shopCategory ShopCategory @relation(fields: [shopCategoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([voucherId, shopCategoryId])
  @@index([shopCategoryId])
  @@map("VoucherShopCategories")
}

model VoucherUsage {
  id             BigInt   @id @default(autoincrement()) @map("VoucherUsageID")
  voucherId      BigInt   @map("VoucherID")
  userId         BigInt   @map("UserID")
  orderId        BigInt?  @map("OrderID")
  shopOrderId    BigInt?  @map("ShopOrderID")
  discountAmount Decimal  @map("DiscountAmount") @db.Decimal(18, 2)
  usedAt         DateTime @default(now()) @map("UsedAt") @db.Timestamp(3)

  voucher   Voucher    @relation(fields: [voucherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order     Order?     @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shopOrder ShopOrder? @relation(fields: [shopOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([voucherId])
  @@index([userId])
  @@index([orderId])
  @@map("VoucherUsages")
}

model ProductReview {
  id               BigInt    @id @default(autoincrement()) @map("ProductReviewID")
  orderItemId      BigInt    @map("OrderItemID")
  productId        BigInt    @map("ProductID")
  productVariantId BigInt?   @map("ProductVariantID")
  userId           BigInt    @map("UserID")
  rating           Int       @map("Rating") @db.SmallInt
  reviewTitle      String?   @map("ReviewTitle") @db.VarChar(255)
  reviewContent    String?   @map("ReviewContent") @db.VarChar(2000)
  reviewStatus     String    @default("Published") @map("ReviewStatus") @db.VarChar(50)
  createdAt        DateTime  @default(now()) @map("CreatedAt") @db.Timestamp(3)
  updatedAt        DateTime? @map("UpdatedAt") @db.Timestamp(3)

  orderItem      OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product        Product         @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           User            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([orderItemId, userId])
  @@index([productId])
  @@map("ProductReviews")
}

model ShopReview {
  id            BigInt   @id @default(autoincrement()) @map("ShopReviewID")
  shopOrderId   BigInt   @map("ShopOrderID")
  shopId        BigInt   @map("ShopID")
  userId        BigInt   @map("UserID")
  rating        Int      @map("Rating") @db.SmallInt
  reviewContent String?  @map("ReviewContent") @db.VarChar(2000)
  reviewStatus  String   @default("Published") @map("ReviewStatus") @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("CreatedAt") @db.Timestamp(3)

  shopOrder ShopOrder @relation(fields: [shopOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([shopOrderId, userId])
  @@index([shopId])
  @@map("ShopReviews")
}

model ShippingReview {
  id                BigInt   @id @default(autoincrement()) @map("ShippingReviewID")
  shipmentId        BigInt   @map("ShipmentID")
  shippingCompanyId BigInt   @map("ShippingCompanyID")
  userId            BigInt   @map("UserID")
  rating            Int      @map("Rating") @db.SmallInt
  reviewContent     String?  @map("ReviewContent") @db.VarChar(2000)
  reviewStatus      String   @default("Published") @map("ReviewStatus") @db.VarChar(50)
  createdAt         DateTime @default(now()) @map("CreatedAt") @db.Timestamp(3)

  shipment        Shipment        @relation(fields: [shipmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shippingCompany ShippingCompany @relation(fields: [shippingCompanyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user            User            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([shipmentId, userId])
  @@index([shippingCompanyId])
  @@map("ShippingReviews")
}

model ReturnRequest {
  id                    BigInt    @id @default(autoincrement()) @map("ReturnRequestID")
  returnCode            String    @unique @map("ReturnCode") @db.VarChar(80)
  orderId               BigInt    @map("OrderID")
  shopOrderId           BigInt    @map("ShopOrderID")
  userId                BigInt    @map("UserID")
  shopId                BigInt    @map("ShopID")
  returnReason          String    @map("ReturnReason") @db.VarChar(1000)
  returnRequestStatus   String    @default("Pending") @map("ReturnRequestStatus") @db.VarChar(50)
  requestedRefundAmount Decimal   @map("RequestedRefundAmount") @db.Decimal(18, 2)
  deadlineAt            DateTime  @map("DeadlineAt") @db.Timestamp(3)
  reviewedByUserId      BigInt?   @map("ReviewedByUserID")
  reviewedAt            DateTime? @map("ReviewedAt") @db.Timestamp(3)
  resolutionNote        String?   @map("ResolutionNote") @db.VarChar(2000)
  createdAt             DateTime  @default(now()) @map("CreatedAt") @db.Timestamp(3)
  updatedAt             DateTime? @map("UpdatedAt") @db.Timestamp(3)

  order          Order     @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shopOrder      ShopOrder @relation(fields: [shopOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           User      @relation("ReturnRequestUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewedByUser User?     @relation("ReturnRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  items                  ReturnRequestItem[]
  refundRequests         RefundRequest[]
  complaints             Complaint[]
  complaintEvidenceFiles ComplaintEvidenceFile[]

  @@index([orderId])
  @@index([shopOrderId])
  @@index([userId])
  @@map("ReturnRequests")
}

model ReturnRequestItem {
  id                    BigInt   @id @default(autoincrement()) @map("ReturnRequestItemID")
  returnRequestId       BigInt   @map("ReturnRequestID")
  orderItemId           BigInt   @map("OrderItemID")
  quantity              Int      @map("Quantity")
  requestedRefundAmount Decimal  @map("RequestedRefundAmount") @db.Decimal(18, 2)
  itemCondition         String?  @map("ItemCondition") @db.VarChar(50)
  createdAt             DateTime @default(now()) @map("CreatedAt") @db.Timestamp(3)

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([returnRequestId])
  @@index([orderItemId])
  @@map("ReturnRequestItems")
}

model RefundRequest {
  id                  BigInt    @id @default(autoincrement()) @map("RefundRequestID")
  refundRequestCode   String    @unique @map("RefundRequestCode") @db.VarChar(80)
  orderId             BigInt    @map("OrderID")
  shopOrderId         BigInt?   @map("ShopOrderID")
  paymentId           BigInt    @map("PaymentID")
  returnRequestId     BigInt?   @map("ReturnRequestID")
  complaintId         BigInt?   @map("ComplaintID")
  requestedByUserId   BigInt    @map("RequestedByUserID")
  amount              Decimal   @map("Amount") @db.Decimal(18, 2)
  refundRequestStatus String    @default("Pending") @map("RefundRequestStatus") @db.VarChar(50)
  reason              String?   @map("Reason") @db.VarChar(1000)
  approvedByUserId    BigInt?   @map("ApprovedByUserID")
  approvedAt          DateTime? @map("ApprovedAt") @db.Timestamp(3)
  createdAt           DateTime  @default(now()) @map("CreatedAt") @db.Timestamp(3)

  order           Order          @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shopOrder       ShopOrder?     @relation(fields: [shopOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment         Payment        @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  complaint       Complaint?     @relation(fields: [complaintId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestedByUser User           @relation("RefundRequestRequestedBy", fields: [requestedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedByUser  User?          @relation("RefundRequestApprovedBy", fields: [approvedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  refunds Refund[]

  @@index([orderId])
  @@index([paymentId])
  @@index([returnRequestId])
  @@map("RefundRequests")
}

model Refund {
  id                 BigInt    @id @default(autoincrement()) @map("RefundID")
  refundRequestId    BigInt    @map("RefundRequestID")
  paymentId          BigInt    @map("PaymentID")
  refundCode         String    @unique @map("RefundCode") @db.VarChar(80)
  providerRefundCode String?   @map("ProviderRefundCode") @db.VarChar(255)
  amount             Decimal   @map("Amount") @db.Decimal(18, 2)
  refundStatus       String    @default("Pending") @map("RefundStatus") @db.VarChar(50)
  refundedAt         DateTime? @map("RefundedAt") @db.Timestamp(3)
  providerResponse   String?   @map("ProviderResponse") @db.Text
  createdAt          DateTime  @default(now()) @map("CreatedAt") @db.Timestamp(3)
  updatedAt          DateTime? @map("UpdatedAt") @db.Timestamp(3)

  refundRequest RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([refundRequestId])
  @@index([paymentId])
  @@map("Refunds")
}

model Complaint {
  id                       BigInt    @id @default(autoincrement()) @map("ComplaintID")
  complaintCode            String    @unique @map("ComplaintCode") @db.VarChar(80)
  complaintType            String    @map("ComplaintType") @db.VarChar(50)
  orderId                  BigInt?   @map("OrderID")
  shopOrderId              BigInt?   @map("ShopOrderID")
  shipmentId               BigInt?   @map("ShipmentID")
  returnRequestId          BigInt?   @map("ReturnRequestID")
  complainantUserId        BigInt    @map("ComplainantUserID")
  againstShopId            BigInt?   @map("AgainstShopID")
  againstShippingCompanyId BigInt?   @map("AgainstShippingCompanyID")
  complaintTitle           String    @map("ComplaintTitle") @db.VarChar(255)
  complaintContent         String    @map("ComplaintContent") @db.VarChar(3000)
  complaintStatus          String    @default("Open") @map("ComplaintStatus") @db.VarChar(50)
  deadlineAt               DateTime  @map("DeadlineAt") @db.Timestamp(3)
  assignedAdminUserId      BigInt?   @map("AssignedAdminUserID")
  createdAt                DateTime  @default(now()) @map("CreatedAt") @db.Timestamp(3)
  updatedAt                DateTime? @map("UpdatedAt") @db.Timestamp(3)

  order                  Order?           @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shopOrder              ShopOrder?       @relation(fields: [shopOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shipment               Shipment?        @relation(fields: [shipmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  returnRequest          ReturnRequest?   @relation(fields: [returnRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  complainantUser        User             @relation("ComplaintComplainant", fields: [complainantUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  againstShop            Shop?            @relation("ComplaintAgainstShop", fields: [againstShopId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  againstShippingCompany ShippingCompany? @relation("ComplaintAgainstShippingCompany", fields: [againstShippingCompanyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedAdminUser      User?            @relation("ComplaintAssignedAdmin", fields: [assignedAdminUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  refundRequests RefundRequest[]
  evidenceFiles  ComplaintEvidenceFile[]
  resolutions    ComplaintResolution[]

  @@index([orderId])
  @@index([shopOrderId])
  @@index([complainantUserId])
  @@index([complaintStatus])
  @@map("Complaints")
}

model ComplaintEvidenceFile {
  id               BigInt   @id @default(autoincrement()) @map("ComplaintEvidenceFileID")
  complaintId      BigInt?  @map("ComplaintID")
  returnRequestId  BigInt?  @map("ReturnRequestID")
  uploadedByUserId BigInt   @map("UploadedByUserID")
  fileType         String   @map("FileType") @db.VarChar(50)
  fileUrl          String   @map("FileUrl") @db.VarChar(1000)
  description      String?  @map("Description") @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("CreatedAt") @db.Timestamp(3)

  complaint      Complaint?     @relation(fields: [complaintId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  returnRequest  ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploadedByUser User           @relation("ComplaintEvidenceUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([complaintId])
  @@index([returnRequestId])
  @@map("ComplaintEvidenceFiles")
}

model ComplaintResolution {
  id                 BigInt   @id @default(autoincrement()) @map("ComplaintResolutionID")
  complaintId        BigInt   @map("ComplaintID")
  resolvedByUserId   BigInt   @map("ResolvedByUserID")
  resolutionType     String   @map("ResolutionType") @db.VarChar(50)
  compensationAmount Decimal? @map("CompensationAmount") @db.Decimal(18, 2)
  resolutionContent  String   @map("ResolutionContent") @db.VarChar(3000)
  createdAt          DateTime @default(now()) @map("CreatedAt") @db.Timestamp(3)

  complaint      Complaint @relation(fields: [complaintId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolvedByUser User      @relation("ComplaintResolutionResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([complaintId])
  @@map("ComplaintResolutions")
}
