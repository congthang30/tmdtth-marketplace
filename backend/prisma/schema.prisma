  productId         BigInt   @map("ProductID")
  productVariantId  BigInt   @map("ProductVariantID")
  quantityOnHand    Int      @default(0) @map("QuantityOnHand")
  quantityReserved  Int      @default(0) @map("QuantityReserved")
  quantityAvailable Int      @default(0) @map("QuantityAvailable")
  quantityDamaged   Int      @default(0) @map("QuantityDamaged")
