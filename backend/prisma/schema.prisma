}

model InventoryTransaction {
  id                 BigInt   @id @default(autoincrement()) @map("InventoryTransactionID")
  productInventoryId BigInt   @map("ProductInventoryID")
  transactionType    String   @map("TransactionType") @db.VarChar(50)
  quantityChange     Int      @map("QuantityChange")
  quantityAfter      Int      @map("QuantityAfter")
  referenceType      String?  @map("ReferenceType") @db.VarChar(50)
  referenceId        BigInt?  @map("ReferenceID")
  note               String?  @map("Note") @db.VarChar(500)
  createdByUserId    BigInt?  @map("CreatedByUserID")
  createdAt          DateTime @default(now()) @map("CreatedAt") @db.Timestamp(3)

