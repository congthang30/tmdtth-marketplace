  shippingServiceId BigInt?   @map("ShippingServiceID")
  shippingQuoteId   BigInt?   @map("ShippingQuoteID")
  orderStatus       String    @default("WaitingForSeller") @map("OrderStatus") @db.VarChar(50)
  subtotalAmount    Decimal   @default(0) @map("SubtotalAmount") @db.Decimal(18, 2)
  discountAmount    Decimal   @default(0) @map("DiscountAmount") @db.Decimal(18, 2)
  shippingFeeAmount Decimal   @default(0) @map("ShippingFeeAmount") @db.Decimal(18, 2)
  totalAmount       Decimal   @map("TotalAmount") @db.Decimal(18, 2)
  sellerNote        String?   @map("SellerNote") @db.VarChar(1000)
  confirmedAt       DateTime? @map("ConfirmedAt") @db.Timestamp(3)
  preparedAt        DateTime? @map("PreparedAt") @db.Timestamp(3)
  completedAt       DateTime? @map("CompletedAt") @db.Timestamp(3)
  createdAt         DateTime  @default(now()) @map("CreatedAt") @db.Timestamp(3)
  updatedAt         DateTime? @map("UpdatedAt") @db.Timestamp(3)

  order           Order            @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shippingCompany ShippingCompany? @relation(fields: [shippingCompanyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shippingService ShippingService? @relation(fields: [shippingServiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shippingQuote   ShippingQuote?   @relation(fields: [shippingQuoteId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  items           OrderItem[]
  statusHistories OrderStatusHistory[]
  notes           OrderNote[]
  cancellations   OrderCancellation[]
  shipments       Shipment[]
  voucherUsages   VoucherUsage[]
  shopReviews     ShopReview[]
  returnRequests  ReturnRequest[]
  refundRequests  RefundRequest[]
  complaints      Complaint[]

  @@index([orderId])
  @@index([shopId])
  @@index([orderStatus])
  @@map("ShopOrders")
}

model OrderItem {
  id                  BigInt   @id @default(autoincrement()) @map("OrderItemID")
  orderId             BigInt   @map("OrderID")
  shopOrderId         BigInt   @map("ShopOrderID")
  shopId              BigInt   @map("ShopID")
  productId           BigInt   @map("ProductID")
  productVariantId    BigInt   @map("ProductVariantID")
