  variantNameSnapshot String?  @map("VariantNameSnapshot") @db.VarChar(255)
  skuSnapshot         String?  @map("SKUSnapshot") @db.VarChar(100)
  unitPrice           Decimal  @map("UnitPrice") @db.Decimal(18, 2)
