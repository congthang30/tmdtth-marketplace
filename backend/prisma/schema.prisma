// schema.prisma
// CSDL Prisma cho sàn thương mại điện tử đồ gia dụng.
// Dựa trên file Lab 3: Users, Shops, Products, Inventory, Cart, Orders,
// Shipping, Payments, Vouchers, Reviews, Returns, Refunds, Complaints.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ShopOperationMode {
  Open
  PausedUntil
  PausedIndefinitely
}

enum ShopOperationAction {
  ScheduledPause
  IndefinitePause
  Resume
  AdminSuspend
  AdminResume
}

enum SellerType {
  Individual
  Business
}

enum BusinessType {
  Company
  HouseholdBusiness
}

enum IdentityDocumentType {
  CitizenId
  LegacyId
  Passport
}

enum VerificationStatus {
  Draft
  Submitted
  UnderReview
  NeedsRevision
  Approved
  Rejected
  Suspended
}

enum ReviewStatus {
  Pending
  InProgress
  NeedsRevision
  Approved
  Rejected
}

enum DocumentStatus {
  Pending
  Accepted
  Rejected
}

enum SellerDocumentAccessRole {
  Owner
  Admin
}

enum SellerDocumentType {
  IdentityFront
  IdentityBack
  Passport
  BusinessRegistration
  LegalRepresentativeIdentity
  FaceVerification
  BankAccountProof
}

model User {
  id             BigInt    @id @default(autoincrement()) @map("UserID")
  code           String    @unique @default(uuid()) @map("UserCode") @db.Uuid
  email          String    @unique @map("Email") @db.VarChar(255)
  phoneNumber    String?   @map("PhoneNumber") @db.VarChar(20)
  passwordHash   String?   @map("PasswordHash") @db.VarChar(500)
  userStatus     String    @default("PendingVerification") @map("UserStatus") @db.VarChar(50)
  emailConfirmed Boolean   @default(false) @map("EmailConfirmed")
  phoneConfirmed Boolean   @default(false) @map("PhoneConfirmed")
  lastLoginAt    DateTime? @map("LastLoginAt") @db.Timestamp(3)
  isDeleted      Boolean   @default(false) @map("IsDeleted")
  createdAt      DateTime  @default(now()) @map("CreatedAt") @db.Timestamp(3)
  updatedAt      DateTime? @map("UpdatedAt") @db.Timestamp(3)
  deletedAt      DateTime? @map("DeletedAt") @db.Timestamp(3)

  profile         UserProfile?
  addresses       Address[]
  carts           Cart[]
  orders          Order[]
  voucherUsages   VoucherUsage[]
  productReviews  ProductReview[]
  shopReviews     ShopReview[]
  shippingReviews ShippingReview[]

  ownedShops                      Shop[]                       @relation("ShopOwner")
  approvedShops                   Shop[]                       @relation("ShopApprover")
  createdProducts                 Product[]                    @relation("ProductCreatedBy")
  updatedProducts                 Product[]                    @relation("ProductUpdatedBy")
  productModerationLogs           ProductModerationLog[]       @relation("ProductModerationModerator")
  inventoryTransactionsCreated    InventoryTransaction[]       @relation("InventoryTransactionCreatedBy")
  orderStatusHistoriesChanged     OrderStatusHistory[]         @relation("OrderStatusChangedBy")
  orderNotesCreated               OrderNote[]                  @relation("OrderNoteCreatedBy")
  orderCancellationsRequested     OrderCancellation[]          @relation("OrderCancellationRequestedBy")
  orderCancellationsApproved      OrderCancellation[]          @relation("OrderCancellationApprovedBy")
  shipmentTrackingHistoriesEdited ShipmentTrackingHistory[]    @relation("ShipmentTrackingUpdatedBy")
  returnRequests                  ReturnRequest[]              @relation("ReturnRequestUser")
  reviewedReturnRequests          ReturnRequest[]              @relation("ReturnRequestReviewer")
  refundRequests                  RefundRequest[]              @relation("RefundRequestRequestedBy")
  approvedRefundRequests          RefundRequest[]              @relation("RefundRequestApprovedBy")
  complaints                      Complaint[]                  @relation("ComplaintComplainant")
  assignedComplaints              Complaint[]                  @relation("ComplaintAssignedAdmin")
  complaintEvidenceFilesUploaded  ComplaintEvidenceFile[]      @relation("ComplaintEvidenceUploadedBy")
  complaintResolutionsResolved    ComplaintResolution[]        @relation("ComplaintResolutionResolvedBy")
  sellerVerificationsReviewed     SellerVerificationProfile[]  @relation("SellerVerificationReviewer")
  sellerVerificationDocuments     SellerVerificationDocument[] @relation("SellerVerificationDocumentUploader")
  sellerDocumentAccessAudits      SellerDocumentAccessAudit[]  @relation("SellerDocumentAccessActor")
  sellerVerificationReviews       SellerVerificationReview[]   @relation("SellerVerificationReviewActor")
  sellerVerificationHistories     SellerVerificationHistory[]  @relation("SellerVerificationHistoryActor")
  shopOperationHistories          ShopOperationHistory[]       @relation("ShopOperationActor")
  shopsOperationUpdated           Shop[]                       @relation("ShopOperationUpdatedBy")
  uploadAssets                    UploadAsset[]                @relation("UploadAssetOwner")

  @@map("Users")
}

model UserProfile {
  userId      BigInt    @id @map("UserID")
  fullName    String    @map("FullName") @db.VarChar(150)
  gender      String?   @map("Gender") @db.VarChar(20)
  dateOfBirth DateTime? @map("DateOfBirth") @db.Date
  avatarUrl   String?   @map("AvatarUrl") @db.VarChar(1000)
  createdAt   DateTime  @default(now()) @map("CreatedAt") @db.Timestamp(3)
  updatedAt   DateTime? @map("UpdatedAt") @db.Timestamp(3)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("UserProfiles")
}

model Address {
  id            BigInt    @id @default(autoincrement()) @map("AddressID")
  userId        BigInt    @map("UserID")
  receiverName  String    @map("ReceiverName") @db.VarChar(150)
  phoneNumber   String    @map("PhoneNumber") @db.VarChar(20)
  province      String    @map("Province") @db.VarChar(100)
  ward          String    @map("Ward") @db.VarChar(100)
  streetAddress String    @map("StreetAddress") @db.VarChar(255)
  fullAddress   String?   @map("FullAddress") @db.VarChar(600)
  isDefault     Boolean   @default(false) @map("IsDefault")
  isDeleted     Boolean   @default(false) @map("IsDeleted")
  createdAt     DateTime  @default(now()) @map("CreatedAt") @db.Timestamp(3)
  updatedAt     DateTime? @map("UpdatedAt") @db.Timestamp(3)
  deletedAt     DateTime? @map("DeletedAt") @db.Timestamp(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders Order[]

  @@index([userId])
  @@map("Addresses")
}

model Shop {
  id                       BigInt            @id @default(autoincrement()) @map("ShopID")
  ownerUserId              BigInt            @map("OwnerUserID")
  code                     String            @unique @default(uuid()) @map("ShopCode") @db.Uuid
  shopName                 String            @map("ShopName") @db.VarChar(150)
  slug                     String            @unique @map("Slug") @db.VarChar(180)
  description              String?           @map("Description") @db.VarChar(1000)
  email                    String?           @map("Email") @db.VarChar(255)
  phoneNumber              String?           @map("PhoneNumber") @db.VarChar(20)
  province                 String?           @map("Province") @db.VarChar(100)
  ward                     String?           @map("Ward") @db.VarChar(100)
  streetAddress            String?           @map("StreetAddress") @db.VarChar(255)
  taxCode                  String?           @map("TaxCode") @db.VarChar(50)
  shopStatus               String            @default("PendingApproval") @map("ShopStatus") @db.VarChar(50)
  approvedByUserId         BigInt?           @map("ApprovedByUserID")
  approvedAt               DateTime?         @map("ApprovedAt") @db.Timestamp(3)
  rejectionReason          String?           @map("RejectionReason") @db.VarChar(1000)
  operationMode            ShopOperationMode @default(Open) @map("OperationMode")
  pauseStartsAt            DateTime?         @map("PauseStartsAt") @db.Timestamp(3)
  pauseEndsAt              DateTime?         @map("PauseEndsAt") @db.Timestamp(3)
  pauseReason              String?           @map("PauseReason") @db.VarChar(500)
  operationUpdatedByUserId BigInt?           @map("OperationUpdatedByUserID")
  operationUpdatedAt       DateTime?         @map("OperationUpdatedAt") @db.Timestamp(3)
  isDeleted                Boolean           @default(false) @map("IsDeleted")
  createdAt                DateTime          @default(now()) @map("CreatedAt") @db.Timestamp(3)
  updatedAt                DateTime?         @map("UpdatedAt") @db.Timestamp(3)
  deletedAt                DateTime?         @map("DeletedAt") @db.Timestamp(3)

  ownerUser              User  @relation("ShopOwner", fields: [ownerUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedByUser         User? @relation("ShopApprover", fields: [approvedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  operationUpdatedByUser User? @relation("ShopOperationUpdatedBy", fields: [operationUpdatedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  products       Product[]
  shopCategories ShopCategory[]
  cartItems      CartItem[]
  shopOrders     ShopOrder[]
  orderItems     OrderItem[]
  shippingQuotes ShippingQuote[]
  vouchers       Voucher[]
  saleCampaigns  ShopSaleCampaign[]
  shopReviews    ShopReview[]
  returnRequests ReturnRequest[]
  complaints     Complaint[]        @relation("ComplaintAgainstShop")

  sellerVerification SellerVerificationProfile?
  operationHistories ShopOperationHistory[]

  @@index([ownerUserId])
  @@index([shopStatus, operationMode])
  @@index([operationMode, pauseStartsAt, pauseEndsAt])
  @@map("Shops")
}

model ShopOperationHistory {
  id          BigInt              @id @default(autoincrement()) @map("ShopOperationHistoryID")
  shopId      BigInt              @map("ShopID")
  action      ShopOperationAction @map("Action")
  startsAt    DateTime?           @map("StartsAt") @db.Timestamp(3)
  endsAt      DateTime?           @map("EndsAt") @db.Timestamp(3)
  reason      String?             @map("Reason") @db.VarChar(500)
  actorUserId BigInt              @map("ActorUserID")
  actorRole   String              @map("ActorRole") @db.VarChar(30)
  createdAt   DateTime            @default(now()) @map("CreatedAt") @db.Timestamp(3)

  shop  Shop @relation(fields: [shopId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor User @relation("ShopOperationActor", fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([shopId, createdAt])
  @@index([actorUserId])
  @@map("ShopOperationHistories")
}

model SellerVerificationProfile {
  id                                  BigInt                @id @default(autoincrement()) @map("SellerVerificationProfileID")
  shopId                              BigInt                @unique @map("ShopID")
  sellerType                          SellerType            @map("SellerType")
  businessType                        BusinessType?         @map("BusinessType")
  legalName                           String                @map("LegalName") @db.VarChar(200)
  identityDocumentType                IdentityDocumentType? @map("IdentityDocumentType")
  identityNumberEncrypted             String?               @map("IdentityNumberEncrypted") @db.Text
  identityNumberHash                  String?               @unique @map("IdentityNumberHash") @db.VarChar(64)
  identityNumberLast4                 String?               @map("IdentityNumberLast4") @db.VarChar(4)
  identityIssuedAt                    DateTime?             @map("IdentityIssuedAt") @db.Date
  identityIssuedBy                    String?               @map("IdentityIssuedBy") @db.VarChar(200)
  identityExpiresAt                   DateTime?             @map("IdentityExpiresAt") @db.Date
  taxCodeEncrypted                    String?               @map("TaxCodeEncrypted") @db.Text
  taxCodeHash                         String?               @unique @map("TaxCodeHash") @db.VarChar(64)
  taxCodeLast4                        String?               @map("TaxCodeLast4") @db.VarChar(4)
  businessRegistrationNumberEncrypted String?               @map("BusinessRegistrationNumberEncrypted") @db.Text
  businessRegistrationNumberHash      String?               @unique @map("BusinessRegistrationNumberHash") @db.VarChar(64)
  businessRegistrationNumberLast4     String?               @map("BusinessRegistrationNumberLast4") @db.VarChar(4)
  businessRegistrationIssuedAt        DateTime?             @map("BusinessRegistrationIssuedAt") @db.Date
  businessRegistrationIssuedBy        String?               @map("BusinessRegistrationIssuedBy") @db.VarChar(200)
  legalRepresentativeName             String?               @map("LegalRepresentativeName") @db.VarChar(200)
  registeredAddress                   String?               @map("RegisteredAddress") @db.VarChar(600)
  dateOfBirth                         DateTime?             @map("DateOfBirth") @db.Date
  contactName                         String?               @map("ContactName") @db.VarChar(100)
  contactEmail                        String?               @map("ContactEmail") @db.VarChar(255)
  contactEmailVerifiedAt              DateTime?             @map("ContactEmailVerifiedAt") @db.Timestamp(3)
  contactPhone                        String?               @map("ContactPhone") @db.VarChar(20)
  useAccountPhone                     Boolean               @default(true) @map("UseAccountPhone")
  faceVerified                        Boolean               @default(false) @map("FaceVerified")
  verificationStatus                  VerificationStatus    @default(Draft) @map("VerificationStatus")
  submittedAt                         DateTime?             @map("SubmittedAt") @db.Timestamp(3)
  reviewedAt                          DateTime?             @map("ReviewedAt") @db.Timestamp(3)
  reviewedByUserId                    BigInt?               @map("ReviewedByUserID")
  createdAt                           DateTime              @default(now()) @map("CreatedAt") @db.Timestamp(3)
  updatedAt                           DateTime?             @map("UpdatedAt") @db.Timestamp(3)

  shop           Shop                         @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewedByUser User?                        @relation("SellerVerificationReviewer", fields: [reviewedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents      SellerVerificationDocument[]
  reviews        SellerVerificationReview[]
  histories      SellerVerificationHistory[]

  @@index([verificationStatus, createdAt])
  @@index([reviewedByUserId])
  @@map("SellerVerificationProfiles")
}

model SellerVerificationDocument {
  id                    BigInt             @id @default(autoincrement()) @map("SellerVerificationDocumentID")
  verificationProfileId BigInt             @map("SellerVerificationProfileID")
  documentType          SellerDocumentType @map("DocumentType")
  storageProvider       String             @default("Cloudinary") @map("StorageProvider") @db.VarChar(50)
  storagePublicId       String             @unique @map("StoragePublicID") @db.VarChar(500)
  deliveryType          String             @map("DeliveryType") @db.VarChar(50)
  resourceType          String             @map("ResourceType") @db.VarChar(50)
  format                String             @map("Format") @db.VarChar(20)
  mimeType              String             @map("MimeType") @db.VarChar(100)
  originalFileName      String             @map("OriginalFileName") @db.VarChar(255)
  bytes                 Int                @map("Bytes")
  checksum              String?            @map("Checksum") @db.VarChar(128)
  documentStatus        DocumentStatus     @default(Pending) @map("DocumentStatus")
  expiresAt             DateTime?          @map("ExpiresAt") @db.Date
  uploadedByUserId      BigInt             @map("UploadedByUserID")
  isDeleted             Boolean            @default(false) @map("IsDeleted")
  createdAt             DateTime           @default(now()) @map("CreatedAt") @db.Timestamp(3)
  updatedAt             DateTime?          @map("UpdatedAt") @db.Timestamp(3)
  deletedAt             DateTime?          @map("DeletedAt") @db.Timestamp(3)

  verificationProfile SellerVerificationProfile   @relation(fields: [verificationProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploadedByUser      User                        @relation("SellerVerificationDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  accessAudits        SellerDocumentAccessAudit[]

  @@index([verificationProfileId, documentType])
  @@index([uploadedByUserId])
  @@map("SellerVerificationDocuments")
}

model SellerDocumentAccessAudit {
  id           BigInt                   @id @default(autoincrement()) @map("SellerDocumentAccessAuditID")
  documentId   BigInt                   @map("SellerVerificationDocumentID")
  actorUserId  BigInt                   @map("ActorUserID")
  accessRole   SellerDocumentAccessRole @map("AccessRole")
  purpose      String                   @map("Purpose") @db.VarChar(200)
  ipAddress    String?                  @map("IPAddress") @db.VarChar(64)
  userAgent    String?                  @map("UserAgent") @db.VarChar(500)
  signedUrlTtl Int                      @map("SignedUrlTTLSeconds")
  createdAt    DateTime                 @default(now()) @map("CreatedAt") @db.Timestamp(3)

  document SellerVerificationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor    User                       @relation("SellerDocumentAccessActor", fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([documentId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("SellerDocumentAccessAudits")
}

model SellerVerificationReview {
  id                    BigInt              @id @default(autoincrement()) @map("SellerVerificationReviewID")
  verificationProfileId BigInt              @map("SellerVerificationProfileID")
  reviewStatus          ReviewStatus        @default(Pending) @map("ReviewStatus")
  fromStatus            VerificationStatus? @map("FromStatus")
  toStatus              VerificationStatus  @map("ToStatus")
  reason                String?             @map("Reason") @db.VarChar(1000)
  reviewerUserId        BigInt              @map("ReviewerUserID")
  createdAt             DateTime            @default(now()) @map("CreatedAt") @db.Timestamp(3)

  verificationProfile SellerVerificationProfile @relation(fields: [verificationProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewerUser        User                      @relation("SellerVerificationReviewActor", fields: [reviewerUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([verificationProfileId, createdAt])
  @@index([reviewStatus])
  @@index([reviewerUserId])
  @@map("SellerVerificationReviews")
}

model SellerVerificationHistory {
  id                    BigInt              @id @default(autoincrement()) @map("SellerVerificationHistoryID")
  verificationProfileId BigInt              @map("SellerVerificationProfileID")
  fromStatus            VerificationStatus? @map("FromStatus")
  toStatus              VerificationStatus  @map("ToStatus")
  reason                String?             @map("Reason") @db.VarChar(1000)
  changedByUserId       BigInt              @map("ChangedByUserID")
  createdAt             DateTime            @default(now()) @map("CreatedAt") @db.Timestamp(3)

  verificationProfile SellerVerificationProfile @relation(fields: [verificationProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changedByUser       User                      @relation("SellerVerificationHistoryActor", fields: [changedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([verificationProfileId, createdAt])
  @@index([changedByUserId])
  @@map("SellerVerificationHistories")
}

model Category {
  id               BigInt    @id @default(autoincrement()) @map("CategoryID")
  parentCategoryId BigInt?   @map("ParentCategoryID")
  categoryName     String    @map("CategoryName") @db.VarChar(150)
  slug             String    @unique @map("Slug") @db.VarChar(180)
  description      String?   @map("Description") @db.VarChar(500)
  imageUrl         String?   @map("ImageUrl") @db.VarChar(1000)
  sortOrder        Int       @default(0) @map("SortOrder")
  isActive         Boolean   @default(true) @map("IsActive")
  createdAt        DateTime  @default(now()) @map("CreatedAt") @db.Timestamp(3)
  updatedAt        DateTime? @map("UpdatedAt") @db.Timestamp(3)

  parentCategory    Category?          @relation("CategoryTree", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childCategories   Category[]         @relation("CategoryTree")
  products          Product[]
  voucherCategories VoucherCategory[]

  @@index([parentCategoryId])
  @@map("Categories")
}

model SearchTermStat {
  id             BigInt   @id @default(autoincrement()) @map("SearchTermStatID")
  normalized     String   @unique @map("NormalizedTerm") @db.VarChar(100)
  displayTerm    String   @map("DisplayTerm") @db.VarChar(100)
  searchCount    BigInt   @default(1) @map("SearchCount")
  lastSearchedAt DateTime @default(now()) @map("LastSearchedAt") @db.Timestamp(3)

  @@index([searchCount, lastSearchedAt])
  @@map("SearchTermStats")
}

model Product {
  id              BigInt    @id @default(autoincrement()) @map("ProductID")
  shopId          BigInt    @map("ShopID")
  categoryId      BigInt    @map("CategoryID")
  code            String    @unique @default(uuid()) @map("ProductCode") @db.Uuid
  productName     String    @map("ProductName") @db.VarChar(255)
  slug            String    @map("Slug") @db.VarChar(280)
  description     String?   @map("Description") @db.Text
  brand           String?   @map("Brand") @db.VarChar(150)
  basePrice       Decimal   @map("BasePrice") @db.Decimal(18, 2)
  compareAtPrice  Decimal?  @map("CompareAtPrice") @db.Decimal(18, 2)
  warrantyMonths  Int       @default(0) @map("WarrantyMonths")
  productStatus   String    @default("Draft") @map("ProductStatus") @db.VarChar(50)
  isViolation     Boolean   @default(false) @map("IsViolation")
  viewCount       BigInt    @default(0) @map("ViewCount")
  soldCount       BigInt    @default(0) @map("SoldCount")
  isDeleted       Boolean   @default(false) @map("IsDeleted")
  createdByUserId BigInt?   @map("CreatedByUserID")
  updatedByUserId BigInt?   @map("UpdatedByUserID")
  createdAt       DateTime  @default(now()) @map("CreatedAt") @db.Timestamp(3)
  updatedAt       DateTime? @map("UpdatedAt") @db.Timestamp(3)
  deletedAt       DateTime? @map("DeletedAt") @db.Timestamp(3)

  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category      Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdByUser User?    @relation("ProductCreatedBy", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedByUser User?    @relation("ProductUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  variants             ProductVariant[]
  images               ProductImage[]
  inventoryRecords     ProductInventory[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  reviews              ProductReview[]
  moderationLogs       ProductModerationLog[]
  voucherProducts      VoucherProduct[]
  shopCategoryProducts ShopCategoryProduct[]

  @@unique([shopId, slug])
  @@index([categoryId])
  @@index([productStatus])
  @@map("Products")
}

model ProductVariant {
  id                BigInt    @id @default(autoincrement()) @map("ProductVariantID")
  productId         BigInt    @map("ProductID")
  sku               String    @map("SKU") @db.VarChar(100)
  variantName       String    @map("VariantName") @db.VarChar(255)
  attributes        Json      @default("{}") @map("Attributes") @db.JsonB
  price             Decimal   @map("Price") @db.Decimal(18, 2)
  compareAtPrice    Decimal?  @map("CompareAtPrice") @db.Decimal(18, 2)
  weightGram        Int       @default(0) @map("WeightGram")
  variantStatus     String    @default("Active") @map("VariantStatus") @db.VarChar(50)
  createdAt         DateTime  @default(now()) @map("CreatedAt") @db.Timestamp(3)
  updatedAt         DateTime? @map("UpdatedAt") @db.Timestamp(3)

  product           Product                 @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  images            ProductImage[]
  inventoryRecords  ProductInventory[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  reviews           ProductReview[]
  saleCampaignItems ShopSaleCampaignItem[]

  @@unique([productId, sku])
  @@index([productId])
  @@map("ProductVariants")
}

model ShopSaleCampaign {
  id           BigInt    @id @default(autoincrement()) @map("ShopSaleCampaignID")
  shopId       BigInt    @map("ShopID")
  campaignName String    @map("CampaignName") @db.VarChar(150)
  startsAt     DateTime  @map("StartsAt") @db.Timestamp(3)
  endsAt       DateTime  @map("EndsAt") @db.Timestamp(3)
  status       String    @default("Scheduled") @map("Status") @db.VarChar(30)
  createdAt    DateTime  @default(now()) @map("CreatedAt") @db.Timestamp(3)
  updatedAt    DateTime? @map("UpdatedAt") @db.Timestamp(3)

  shop  Shop                   @relation(fields: [shopId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items ShopSaleCampaignItem[]

  @@index([shopId, startsAt, endsAt])
  @@index([status])
  @@map("ShopSaleCampaigns")
}

model ShopSaleCampaignItem {
  id               BigInt  @id @default(autoincrement()) @map("ShopSaleCampaignItemID")
  campaignId       BigInt  @map("CampaignID")
  productVariantId BigInt  @map("ProductVariantID")
  salePrice        Decimal @map("SalePrice") @db.Decimal(18, 2)

  campaign       ShopSaleCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productVariant ProductVariant   @relation(fields: [productVariantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([campaignId, productVariantId])
  @@index([productVariantId])
  @@map("ShopSaleCampaignItems")
}

model UploadAsset {
  id              BigInt    @id @default(autoincrement()) @map("UploadAssetID")
  ownerUserId     BigInt    @map("OwnerUserID")
  storagePublicId String    @unique @map("StoragePublicID") @db.VarChar(500)
  url             String    @map("Url") @db.VarChar(1000)
  originalName    String    @map("OriginalName") @db.VarChar(255)
  mimeType        String    @map("MimeType") @db.VarChar(100)
  size            Int       @map("Size")
  status          String    @default("Pending") @map("Status") @db.VarChar(30)
  createdAt       DateTime  @default(now()) @map("CreatedAt") @db.Timestamp(3)
  attachedAt      DateTime? @map("AttachedAt") @db.Timestamp(3)

  owner        User          @relation("UploadAssetOwner", fields: [ownerUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productImage ProductImage?

  @@index([ownerUserId, status, createdAt])
  @@map("UploadAssets")
}

model ProductImage {
  id               BigInt   @id @default(autoincrement()) @map("ProductImageID")
  assetId          BigInt?  @unique @map("AssetID")
  productId        BigInt   @map("ProductID")
  productVariantId BigInt?  @map("ProductVariantID")
  imageUrl         String   @map("ImageUrl") @db.VarChar(1000)
  altText          String?  @map("AltText") @db.VarChar(255)
  sortOrder        Int      @default(0) @map("SortOrder")
