}

model InventoryReservation {
  id                 BigInt    @id @default(autoincrement()) @map("InventoryReservationID")
  productInventoryId BigInt    @map("ProductInventoryID")
  orderId            BigInt    @map("OrderID")
  orderItemId        BigInt    @unique @map("OrderItemID")
  quantity           Int       @map("Quantity")
  reservationStatus  String    @default("Active") @map("ReservationStatus") @db.VarChar(50)
  createdAt          DateTime  @default(now()) @map("CreatedAt") @db.Timestamp(3)
  completedAt        DateTime? @map("CompletedAt") @db.Timestamp(3)
  releasedAt         DateTime? @map("ReleasedAt") @db.Timestamp(3)
  returnedAt         DateTime? @map("ReturnedAt") @db.Timestamp(3)

